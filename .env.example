NODE_ENV=development

PORT=5000

POSTGRES_DB=clouddrop
POSTGRES_USER=clouddrop
POSTGRES_PASSWORD=change-this-password

DATABASE_URL=postgresql://clouddrop:change-this-password@postgres:5432/clouddrop

JWT_SECRET=replace-with-a-long-random-secret

JWT_EXPIRES_IN=24h

AWS_REGION=eu-north-1

AWS_S3_BUCKET=

MAX_FILE_SIZE_MB=10

CLOUDDROP_AWS_PRINCIPAL_ARN=arn:aws:iam::YOUR_CLOUDDROP_ACCOUNT_ID:role/CloudDropApplicationRole